# BookMate environment
# Copy to .env.local and fill in values.
#
# Local demo (no Supabase): omit NEXT_PUBLIC_SUPABASE_* — uses SQLite + /api/auth/*.
# Production (Vercel): set Supabase keys — Auth + rooms live in Supabase; local APIs return 501.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BookMate

# Public links (Settings → Open source)
NEXT_PUBLIC_GITHUB_URL=https://github.com/imahdi2006/Page-Mate
# Buy me a coffee — paused (open source). Uncomment to show the button again.
# NEXT_PUBLIC_SUPPORT_URL=https://buymeacoffee.com/imahdi2006

# --- Supabase (Auth + Postgres + Realtime) — required on Vercel ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push (VAPID) — required for notifications on HTTPS ---
# Generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@BookMate.app

# --- Resend (local-demo forgot-password only; Supabase Auth sends resets in cloud mode) ---
RESEND_API_KEY=
RESEND_FROM=BookMate <beth.t@example.com>
