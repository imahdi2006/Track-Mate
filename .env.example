# PageMate environment
# Copy to .env.local and fill in values. The app runs in local/demo mode
# when Supabase keys are omitted.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PageMate

# --- Supabase (Auth + Postgres + Realtime) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push (VAPID) ---
# Generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@pagemate.app

# --- Resend (forgot-password email) ---
# Server-only. Never expose this to the browser.
RESEND_API_KEY=
# Test: PageMate <beth.t@example.com> (only delivers to your Resend account email)
# Production: a from-address on a domain you verified in Resend
RESEND_FROM=PageMate <beth.t@example.com>
