{
  "name": "trackmate",
  "version": "1.0.0",
  "private": true,
  "description": "Trackmate — a PWA for small groups to track shared books, courses, movies, and series in real time.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "icons": "node scripts/generate-icons.mjs",
    "vapid": "node scripts/generate-vapid-keys.mjs",
    "docs:pdf": "node scripts/generate-docs-pdf.mjs",
