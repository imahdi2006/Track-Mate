    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "marked": "^15.0.7",
